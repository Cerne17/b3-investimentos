 "components": {
  "schemas": {
   "ConsultaSQL": {
    "properties": {
     "query": {
      "type": "string",
      "title": "Query",
      "examples": [
       "SELECT segmento, COUNT(*) n, ROUND(AVG(dividend_yield),2) dy FROM fundos WHERE status='ok' GROUP BY segmento ORDER BY dy DESC"
      ]
     },
     "limite": {
      "type": "integer",
      "maximum": 5000.0,
      "title": "Limite",
      "default": 500
     }
    },
    "type": "object",
    "required": [
     "query"
    ],
    "title": "ConsultaSQL"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "PedidoCarteira": {
    "properties": {
     "tickers": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "minItems": 2,
      "title": "Tickers",
      "description": "Tickers da B3 ou qualquer ticker do Yahoo (AAPL, BTC-USD)",
      "examples": [
       [
        "MXRF11",
        "GARE11",
        "GOLD11",
        "AUVP11"
       ]
      ]
     },
     "valor": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "title": "Valor",
      "description": "Valor a investir (R$)",
      "default": 1000,
      "examples": [
       400
      ]
     },
     "peso_min": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Peso Min",
      "description": "Peso mínimo por ativo (0.05 = 5%)",
      "default": 0.0
     },
     "peso_max": {
      "type": "number",
      "maximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Peso Max",
      "description": "Peso máximo por ativo (0.35 = 35%)",
      "default": 0.35
     },
     "filosofia": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Filosofia",
      "description": "Configura os indicadores automaticamente (ver /api/carteira/opcoes)",
      "examples": [
       "value_conservador"
      ]
     },
     "indicadores": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Indicadores",
      "description": "Objetivos de otimização; se vazio, usa os da filosofia",
      "examples": [
       [
        "sharpe",
        "sortino",
        "calmar",
        "renda_risco"
       ]
      ]
     },
     "periodo": {
      "type": "string",
      "enum": [
       "1y",
       "2y",
       "5y",
       "10y"
      ],
      "title": "Periodo",
      "description": "Janela histórica dos retornos",
      "default": "2y"
     },
     "taxa_livre_risco": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Taxa Livre Risco",
      "description": "Taxa livre de risco anual (0.14 = 14%). Padrão: B3_TAXA_LIVRE_RISCO"
     }
    },
    "type": "object",
    "required": [
     "tickers"
    ],
    "title": "PedidoCarteira"
   },
